{{#if max}}
<div class="status-bar card-{{id}}" data-resource-id="{{id}}" data-action="onIncreaseResource">
    {{#if (eq @root.styleResource 'label')}}
    <div class="status-label pointy">
        <h4>{{label}}</h4>
    </div>
    {{/if}}
    {{#if (eq @root.styleResource 'icon')}}
    <i class="fas {{icon}}"></i>
    {{/if}}
    <div class="status-value">
        <progress class="progress-bar" value="{{value}}" max="{{max}}"></progress>
        {{!-- <input class="bar-input" name="{{concat 'system.resources.' id '.value'}}" min="0" max='{{max}}' value="{{value}}" type="number"> --}}
        <span class="bar-label">{{value}}</span>
        <span>/</span>
        <span class="bar-label">{{max}}</span>
    </div>
</div>
{{/if}}
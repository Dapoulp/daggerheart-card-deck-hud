<form id="item-action-select">
    <header class="dialog-header">
        <h1>{{name}}</h1>
    </header>
    <ul class="action-buttons-list">
        {{#each features}}
            <li class="action-item" data-tooltip="#item#{{uuid}}">
                <button type="button" class="list-button reverted" data-feature-id="{{id}}" data-action="onChooseFeature">
                    <img src="{{ img }}">
                    <span>{{ name }}</span>
                </button>
            </li>
        {{/each}}
    </ul>
</form>
<div class="dh-cd-player">
    <div class="dh-cd-player-resource">
        <div>
            {{#with (lookup resources 0)}}
            {{> 'modules/daggerheart-card-deck-hud/templates/resource.hbs'}}
            {{/with}}
        </div>
        <div>
            {{#with (lookup resources 1)}}
            {{> 'modules/daggerheart-card-deck-hud/templates/resource.hbs'}}
            {{/with}}
        </div>
    </div>
    <div class="dh-cd-player-img" data-player-hp="{{token.hp.value}} / {{token.hp.max}}"
        {{!-- data-resource-id="hitPoints" data-action="onIncreaseResource" --}}
        style="--hp-perc: {{token.hp.perc}}%;"
    >
        <img src="{{token.picture}}">
    </div>
    <div class="dh-cd-player-resource">
        <div>
            {{#with (lookup resources 2)}}
            {{> 'modules/daggerheart-card-deck-hud/templates/resource.hbs'}}
            {{/with}}
        </div>
        <div>
            {{#with (lookup resources 3)}}
            {{> 'modules/daggerheart-card-deck-hud/templates/resource.hbs'}}
            {{/with}}
        </div>
    </div>
</div>
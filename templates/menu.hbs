<div class="dh-cd-control-settings-menu">
    {{#each itemTypes}}
        <label
            draggable="true"
            data-type="{{type}}"
            {{#if (or (and (eq @root.characterType 'environment') (eq type 'weapon')) (and (ne @root.characterType 'environment') (eq type 'potentialAdversaries')))}}hidden{{/if}}
        >
            <i class="fa-solid fa-ellipsis-vertical"></i>
            <span>{{label}}</span>
            <input
                type="checkbox"
                data-type="{{type}}"
                data-action="toggleItemType"
                {{#if active}}checked{{/if}}
            >
        </label>
    {{/each}}
</div>
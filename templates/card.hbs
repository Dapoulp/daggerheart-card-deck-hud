<div
    {{!-- class="card card-{{type}}{{#if subtype}} card-{{subtype}}{{/if}}{{#if domain}} card-{{domain}}{{/if}}" --}}
    class="card {{classes}}"
    data-type="{{ifThen (eq type 'feature') type (ifThen subtype subtype type)}}" style="{{style}}"
    data-item-id="{{uuid}}" data-action="{{#if @root.classes.isTTRPGmode.active}}selectCard{{else}}useCard{{/if}}"
>
    <div class="card-container">
        <div class="card-top" style="background-image: url({{img}})">
            {{#if hasBanner}}
            <div class="card-top-left">
                {{#if level}}<p class="card-top-left-text">{{level}}</p>{{/if}}
            </div>
            {{/if}}
            {{#if recallCost includeZero=true}}
            <div class="card-top-right">
                <p class="card-top-right-text">{{recallCost}}</p>
            </div>
            {{/if}}
        </div>
        <div class="card-bottom">
            <div class="card-title-container">
                <div class="card-title">{{name}}</div>
                {{#if subtitle}}<div class="card-subtitle">{{{subtitle}}}</div>{{/if}}
            </div>
            <div class="card-content overflow-y">
                <div class="card-content-text">
                    {{{description}}}
                </div>
            </div>
        </div>
        <div class="card-footer">
            {{#each tags}}
            <span>{{this}}</span>
            {{/each}}
        </div>
    </div>
    <div class="card-buttons">
        {{#if (eq type "domainCard")}}
        {{#if @root.isVault}}
        <button data-action="sendToLoadout" title="{{localize 'DAGGERHEART.APPLICATIONS.ContextMenu.toLoadout'}}">
            <i class="fa-solid fa-arrow-up fa-fw" inert=""></i>
        </button>
        <button data-action="recall" title="{{localize 'DAGGERHEART.APPLICATIONS.ContextMenu.recall'}}">
            <i class="fa-solid fa-bolt-lightning fa-fw" inert=""></i>
        </button>
        {{else}}
        <button data-action="sendToVault" title="{{localize 'DAGGERHEART.APPLICATIONS.ContextMenu.toVault'}}">
            <i class="fa-solid fa-arrow-down fa-fw" inert=""></i>
        </button>
        {{/if}}
        {{/if}}
        <button data-action="editItem" title="{{localize 'CONTROLS.CommonEdit'}}">
            <i class="fa-solid fa-pen-to-square fa-fw" inert=""></i>
        </button>
        <button data-action="sendToChat" title="{{localize 'DAGGERHEART.APPLICATIONS.ContextMenu.sendToChat'}}">
            <i class="fa-solid fa-message fa-fw" inert=""></i>
        </button>
        {{#if (eq type "beastform")}}
        <button data-action="cancelBeastform" title="{{localize 'DAGGERHEART.ACTORS.Character.cancelBeastform'}}">
            <i class="fa-solid fa-paw fa-fw" inert=""></i>
        </button>
        {{/if}}
    </div>
</div>
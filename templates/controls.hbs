<div class="dh-cd-controls" data-character-type="{{characterType}}">
    {{#if isCharacter}}
    <button type="button" class="dh-cd-control-switch" data-action="toggleVault"{{#if (and (not hasVaultCards) (not isVault))}} disabled{{/if}} data-tooltip="{{localize 'DHDECKCARD.TOOLTIP.SwitchTo' tab=(localize (ifThen isVault 'DAGGERHEART.GENERAL.Tabs.loadout' 'DAGGERHEART.GENERAL.Tabs.vault'))}}" data-tooltip-direction="UP">
        {{localize (ifThen isVault "DAGGERHEART.GENERAL.Tabs.vault" "DAGGERHEART.GENERAL.Tabs.loadout")}}
    </button>
    <button type="button" class="dh-cd-control-switch" data-action="toggleEquipment"{{#if (and (not hasEquipmentCards) (not isEquipment))}} disabled{{/if}} data-tooltip="{{localize 'DHDECKCARD.TOOLTIP.SwitchTo' tab=(localize (ifThen isEquipment 'DHDECKCARD.GENERAL.Deck' 'DAGGERHEART.GENERAL.Tabs.equipment'))}}" data-tooltip-direction="UP">
        {{localize (ifThen isEquipment "DAGGERHEART.GENERAL.Tabs.equipment" "DHDECKCARD.GENERAL.Deck")}}
    </button>
    {{/if}}
    {{#if isFreePositioning}}
    <button type="button" class="dh-cd-control-move fa-solid fa-up-down-left-right icon" data-tooltip="{{localize 'DHDECKCARD.TOOLTIP.DragLock'}}" data-tooltip-direction="UP"></button>
    {{/if}}
    <button type="button" class="dh-cd-control-toggle fa-solid fa-chevron-down icon" data-action="toggleHUD"></button>
    <button type="button" class="dh-cd-control-settings fa-solid fa-gear icon" data-action="toggleMenu"></button>
    {{> 'modules/daggerheart-card-deck-hud/templates/menu.hbs'}}
</div>
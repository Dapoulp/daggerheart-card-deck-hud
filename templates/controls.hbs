<div class="dh-cd-controls">
    {{#if isCharacter}}
    <button type="button" class="dh-cd-control-switch" data-action="toggleVault"{{#if (and (not hasVaultCards) (not isVault))}} disabled{{/if}}>
        {{ifThen isVault "Vault" "Loadout"}}
    </button>
    {{/if}}
    {{#if isFreePositioning}}
    <button type="button" class="dh-cd-control-move">
        <i class="fa-solid fa-up-down-left-right"></i>
    </button>
    {{/if}}
    <button type="button" class="dh-cd-control-toggle" data-action="toggleHUD">
        <i class="fa-solid fa-chevron-down"></i>
    </button>
    <button type="button" class="dh-cd-control-settings" data-action="toggleMenu">
        <i class="fa-solid fa-gear"></i>
    </button>
    {{> 'modules/daggerheart-card-deck-hud/templates/menu.hbs'}}
</div>
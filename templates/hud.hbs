<div class="dh-card-deck {{#if collapsed}}is-collapsed{{/if}}">
    {{#if visible}}
        <div class="dh-cd-cards{{#each classes}}{{#if active}} {{class}}{{/if}}{{/each}}">
            {{#each cards as |card|}}
                {{!-- {{> 'modules/daggerheart-card-deck-hud/templates/card.hbs'}} --}}
                {{{card}}}
            {{/each}}
        </div>
        <div class="dh-cd-controls">
            <button type="button" class="dh-cd-control-switch" data-action="toggleVault"{{#if (and (not hasVaultCards) (not isVault))}} disabled{{/if}}>
                {{ifThen isVault "Vault" "Loadout"}}
                {{!-- <i class="fa-solid fa-retweet"></i> --}}
            </button>
            {{#unless isResourceHidden}}
            {{> 'modules/daggerheart-card-deck-hud/templates/player.hbs'}}
            {{!-- <div class="dh-cd-resources">
                {{#each resources}}
                    {{> 'modules/daggerheart-card-deck-hud/templates/resource.hbs'}}
                {{/each}}
            </div> --}}
            {{/unless}}
            <button type="button" class="dh-cd-control-toggle" data-action="toggleHUD">
                <i class="fa-solid fa-chevron-down"></i>
            </button>
            {{#unless classes.isTTRPGmode.active}}
            <button type="button" class="dh-cd-control-settings" data-action="toggleMenu">
                <i class="fa-solid fa-gear"></i>
            </button>
            {{/unless}}
        </div>
        {{#if menuOpen}}
            {{> 'modules/daggerheart-card-deck-hud/templates/menu.hbs'}}
        {{/if}}
    {{/if}}
</div>